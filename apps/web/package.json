{
  "name": "web",
  "version": "0.1.0",
  "description": "Aayeshol v2 Frontend Application (Next.js 16, React 19, Tailwind CSS v4, shadcn/ui)",
  "author": "Aayeshol Engineering Team",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@aayeshol/types": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "postcss": "^8.5.29",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6.3"
  }
