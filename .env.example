# -------------------------
# Web Environment Variables
# -------------------------
WEB_PORT=3000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001/api

# -------------------------
# API Environment Variables
# -------------------------
API_PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=aayeshol
# This URL is used when running locally (outside of docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aayeshol?schema=public

# Better Auth
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=generate_a_secure_random_string_here

# AI Models
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Social Logins (LinkedIn)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/social/linkedin/callback

# Redis & Queues
REDIS_URL=redis://localhost:6379

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Authentication
JWT_SECRET=generate_a_secure_random_jwt_secret_here
